[Unit]
Description=Portal BI TMB — job report_overdue_daily (if-due)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/portal-bi-tmb
EnvironmentFile=/opt/portal-bi-tmb/.env
ExecStart=/opt/portal-bi-tmb/.venv/bin/python -m worker run report_overdue_daily --if-due

[Install]
WantedBy=multi-user.target
