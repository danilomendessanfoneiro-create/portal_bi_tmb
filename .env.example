# Database
DATABASE_URL=postgresql://portal_bi:SENHA@127.0.0.1:5433/portal_bi_tmb

# Auth JWT (gere um valor longo e aleatório em produção)
JWT_SECRET=troque-este-segredo-em-producao-min-32-chars
JWT_EXPIRE_MINUTES=480
PASSWORD_SALT=tmb-logistica-bi

# Ambiente (aparece no e-mail técnico de monitoramento). Ex.: local | homologação | produção
# Se vazio, deriva de PUBLIC_ORIGIN (localhost → local; demais → produção).
APP_ENV=produção

# URLs públicas (mesmo domínio na VPS)
PUBLIC_ORIGIN=https://cliente.com
API_PUBLIC_URL=https://cliente.com/api
ADMIN_PUBLIC_URL=https://cliente.com/admin
BI_PUBLIC_URL=https://cliente.com/bi

# Local (dev) — abra http://localhost:5173/admin/
# APP_ENV=local
# PUBLIC_ORIGIN=http://localhost:5173
# API_PUBLIC_URL=http://localhost:8000/api
# ADMIN_PUBLIC_URL=http://localhost:5173/admin
# BI_PUBLIC_URL=http://localhost:5173/bi

# hCaptcha (login Admin) — secret só no servidor; sitekey também no frontend/.env
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# SMTP técnico de monitoramento dos robôs (não aparece na UI do cliente)
TECH_SMTP_HOST=smtp.gmail.com
TECH_SMTP_PORT=587
TECH_SMTP_USER=jeverson.abreu@gmail.com
TECH_SMTP_PASSWORD=
TECH_SMTP_FROM=jeverson.abreu@gmail.com
TECH_SMTP_FROM_NAME=jeverson
TECH_SMTP_TO=jeverson.abreu@gmail.com

