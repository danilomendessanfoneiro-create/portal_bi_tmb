# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" (com senhas reais) para o repositório.

# --- Portal TMB (origem do relatorio) ---
TMB_LOGIN_URL=https://tmblogistica.tmselite.com/login
TMB_USER=
TMB_PASS=

# --- Painel Admin (destino da importacao) ---
# Nao usar RPA no Admin: importar via ManualImportService no Portal BI.
ADMIN_LOGIN_URL=
ADMIN_USER=
ADMIN_PASS=

# --- Diretorios ---
DOWNLOAD_DIR=C:\TMB_Automation\downloads
LOG_DIR=C:\TMB_Automation\logs

# --- Outras opcoes ---
WAIT_TIMEOUT=30
# HEADLESS=false ajuda a depurar visualmente enquanto ajusta os seletores.
# Depois que estiver tudo funcionando, mude para true para rodar em segundo plano.
HEADLESS=false
